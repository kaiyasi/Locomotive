# Create a bot with @BotFather and put the token here.
BOT_TOKEN=

# Optional. Comma-separated Telegram user IDs. Empty means any private-chat user.
# ALLOWED_USER_IDS=123456789
ALLOWED_USER_IDS=

# Keep this outside the repository in production if preferred.
DATA_FILE=./data/parking.json
POLLING_TIMEOUT_SECONDS=30
RETRY_DELAY_MS=2000
TIME_ZONE=Asia/Taipei
